import java.util.*;

public class Main {

    static String twoStrings(String s1, String s2) {
        for (char c : s1.toCharArray()) {
            if (s2.indexOf(c) != -1) {
                return "YES";
            }
        }
        return "NO";
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            String s1 = sc.next();
            String s2 = sc.next();

            System.out.println(twoStrings(s1, s2));
        }

        sc.close();
    }
}
